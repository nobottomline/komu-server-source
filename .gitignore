# Ignore project-specific local files and dirs
.gradle
.idea
gradle.properties
.fleet
# But we need these
!.idea/runConfigurations
.kotlin

# Ignore Gradle build output directory
build
server/out
AndroidCompat/out

# Module compiler outputs accidentally tracked by the historical Komu fork.
# Keep these explicit: a broad `bin/` rule could hide intentional scripts.
/AndroidCompat/bin/
/AndroidCompat/Config/bin/
/server/bin/
/server/server-config/bin/
/server/server-config-generate/bin/

# WebUI is either to be downloaded on-demand or is a dynamic build asset
server/src/main/resources/WebUI.zip

# bundling stage downlaoded assets
scripts/OpenJDK*
scripts/zulu*
scripts/electron-*
scripts/rcedit-*
scripts/resources/*.so
